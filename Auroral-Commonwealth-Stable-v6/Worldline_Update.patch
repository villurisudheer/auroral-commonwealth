+ if(type==='Crisis investigation'){const indices=new Set();book.events.forEach((e,i)=>{if(crisis(e))for(let j=Math.max(0,i-6);j<=i;j++)indices.add(j)});entries=book.events.filter((_,i)=>indices.has(i))}
