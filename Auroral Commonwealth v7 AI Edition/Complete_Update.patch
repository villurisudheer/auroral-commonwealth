+function message(text,error=false){let el=app.querySelector('[data-message]');if(!el){el=document.createElement('p');el.dataset.message='';el.setAttribute('role','status');app.prepend(el)}el.className=error?'notice warning':'notice';el.textContent=text}
+function login(info=''){
+ app.innerHTML=`<div class="cd-admin-login"><div class="eyebrow">AURORAL / SECURE OPERATIONS</div><h1>Server administration</h1><p class="cd-muted">Inspect sessions, pause rooms and moderate connected players.</p><form><label>Admin password<input type="password" name="password" autocomplete="current-password" maxlength="256" required></label><button class="cd-primary" type="submit">Sign in to console →</button></form><p data-message role="status">${esc(info)}</p><details><summary>First-time setup</summary><p>Set <code>AC_ADMIN_PASSWORD</code> to a password of at least 12 characters on the Node server, then restart it. Admin access is disabled until configured. The session stays in this page’s memory and expires after one hour.</p><p>PowerShell: set the environment variable using <code>$env:AC_ADMIN_PASSWORD = Read-Host "Admin password"</code>, then run <code>npm.cmd start</code>.</p></details></div>`;
+ app.querySelector('form').onsubmit=async e=>{e.preventDefault();const input=app.querySelector('input'),button=app.querySelector('button');button.disabled=true;try{const result=await request('/session','POST',{password:input.value});input.value='';token=result.token;await refresh()}catch(error){message(error.message,true)}finally{if(button.isConnected)button.disabled=false}};
+}
+async function refresh(){try{status=await request('/status');render()}catch(e){message(e.message,true)}}
+function render(){
+ const roomCount=status.rooms.length,players=status.rooms.reduce((n,r)=>n+r.players.length,0);
+ app.innerHTML=`<header class="cd-admin-header"><div><div class="eyebrow">SERVER OPERATIONS / AUTHENTICATED</div><h1>Admin overview</h1></div><div class="actions"><button class="btn" data-refresh>Refresh</button><button class="btn" data-logout>Sign out</button></div></header><p data-message role="status"></p><div class="cd-admin-stats">${[['Active rooms',roomCount],['Connected players',players],['Uptime',Math.floor(status.uptime/60)+' min'],['Memory',status.memoryMB+' MB']].map(([l,v])=>`<div><span>${l}</span><strong>${v}</strong></div>`).join('')}</div><section class="cd-panel"><div class="eyebrow">MULTIPLAYER CONTROL</div><h2>Live rooms</h2>${status.rooms.length?status.rooms.map(r=>`<article class="cd-admin-room"><header><div><b>${esc(r.code)}</b><span class="pill">${r.started?'In progress':'Lobby'} · ${r.speed}×</span></div><button class="btn small" data-pause="${esc(r.code)}">Pause room</button></header><div class="table-wrap"><table class="table"><thead><tr><th>Player</th><th>Nation</th><th>Role</th><th>Moderation</th></tr></thead><tbody>${r.players.map(p=>`<tr><td>${esc(p.name)}</td><td>${esc(p.country||'Choosing a country')}</td><td>${p.host?'Host':'Player'}</td><td><button class="btn small danger" data-kick="${esc(p.id)}" data-room="${esc(r.code)}">Remove player</button></td></tr>`).join('')}</tbody></table></div></article>`).join(''):'<p class="cd-muted">No active multiplayer rooms. Create a room from the game’s Multiplayer menu to manage it here.</p>'}</section><section class="cd-panel"><div class="eyebrow">ADMIN AUDIT TRAIL</div><h2>Recent operations</h2><div class="table-wrap"><table class="table"><thead><tr><th>Time</th><th>Operation</th><th>Detail</th></tr></thead><tbody>${status.audit.map(x=>`<tr><td>${esc(x.date)}</td><td>${esc(x.action)}</td><td>${esc(x.detail)}</td></tr>`).join('')}</tbody></table></div></section><p class="cd-muted">${esc(status.version)} · ${status.maxPlayers} players per room · server-authoritative controls</p>`;
+ app.querySelector('[data-refresh]').onclick=refresh;app.querySelector('[data-logout]').onclick=async()=>{try{await request('/session','DELETE')}finally{token=null;login('Signed out.')}};
+ app.querySelectorAll('[data-pause]').forEach(b=>b.onclick=async()=>{b.disabled=true;try{await request('/rooms/'+b.dataset.pause+'/pause','POST',{});await refresh();message('Room paused.')}catch(e){message(e.message,true);b.disabled=false}});
+ app.querySelectorAll('[data-kick]').forEach(b=>b.onclick=async()=>{if(!confirm('Remove this player from the current room? They can rejoin using the room code.'))return;b.disabled=true;try{await request('/rooms/'+b.dataset.room+'/kick','POST',{playerId:b.dataset.kick});await refresh();message('Player removed.')}catch(e){message(e.message,true);b.disabled=false}});
+}
+login();
