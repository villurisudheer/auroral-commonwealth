+import {mapSVG,polygonPath} from './map.js';
+const root=path.dirname(fileURLToPath(import.meta.url)),maps=new Map([2026,1942,1919,1783].map(y=>[y,JSON.parse(fs.readFileSync(path.join(root,'data/world-'+y+'.geojson')))]));
+let groups=0;async function test(name,fn){await fn();groups++;console.log('  PASS '+name)}
+await test('All original 202 IDs remain and all expanded scenario IDs are unique',()=>{assert.equal(LEGACY_IDS.size,202);for(const id of LEGACY_IDS)assert.ok(COUNTRIES.some(c=>c.id===id));assert.equal(new Set(COUNTRIES.map(c=>c.id)).size,COUNTRIES.length);assert.equal(new Set(ATLAS_ROWS.map(c=>c.id)).size,ATLAS_ROWS.length);for(const row of ATLAS_ROWS)assert.ok(COUNTRIES.some(c=>c.id===row.id))});
+await test('Modern roster has exactly 193 UN members, 2 observers and all four requested categories',()=>{const modern=eraRows(2026);assert.equal(modern.filter(r=>r.membership==='UN member state').length,193);assert.equal(modern.filter(r=>r.membership==='UN observer state').length,2);assert.equal(modern.filter(r=>r.category==='UN Recognized').length,195);assert.deepEqual(new Set(modern.map(r=>r.category)),new Set(MODERN_CATEGORIES));assert.equal(modern.filter(r=>r.category==='Non-UN Recognized').length,2);assert.ok(modern.some(r=>r.id==='twn'));assert.ok(modern.some(r=>r.id==='xkx'));assert.ok(modern.some(r=>r.id==='tns'))});
+await test('Each era is separated and filtering cannot leak modern or fictional entries into historical rosters',()=>{for(const y of [1942,1919,1783]){assert.ok(eraRows(y).length>100);assert.ok(eraRows(y).every(r=>r.era===y&&r.category!=='Fictional'));assert.equal(eraRows(y).some(r=>r.id==='uss'),false)}assert.ok(eraRows(1783,'','Maratha').length);assert.ok(eraRows(2026,'Fictional').length===3)});
+function checkCoordinates(value){if(typeof value[0]==='number'){assert.ok(Number.isFinite(value[0])&&value[0]>=-180.01&&value[0]<=180.01);assert.ok(Number.isFinite(value[1])&&value[1]>=-90.01&&value[1]<=90.01)}else for(const child of value)checkCoordinates(child)}
+await test('All shipped political geometries and roster references are finite and valid',()=>{for(const [y,data] of maps){assert.equal(data.era,y);assert.equal(data.type,'FeatureCollection');assert.ok(data.features.length>100);const ids=new Set();for(const f of [...data.features,...data.control]){assert.equal(f.type,'Feature');assert.equal(f.properties.countryId,f.countryId);assert.ok(!ids.has(f.id));ids.add(f.id);assert.ok(['Polygon','MultiPolygon'].includes(f.geometry.type));checkCoordinates(f.geometry.coordinates);if(f.countryId){assert.ok(ATLAS_META.has(f.countryId));assert.equal(ATLAS_META.get(f.countryId).era,y)}assert.ok(!/NaN|undefined/.test(polygonPath(f.geometry)))}}});
+await test('1919 and 1942 state records genuinely cover their stated January 1 snapshot',()=>{for(const y of [1919,1942])for(const f of maps.get(y).features){const start=f.validFrom[0]*10000+f.validFrom[1]*100+f.validFrom[2],end=f.validTo[0]*10000+f.validTo[1]*100+f.validTo[2];assert.ok(start<=y*10000+101&&end>=y*10000+101)}});
+await test('Green state borders and red wartime reconstructions are independent and toggle separately',()=>{const d=maps.get(1942);assert.equal(d.control.length,7);assert.ok(d.control.some(f=>f.name==='Nazi Germany'));assert.ok(d.control.some(f=>f.name==='Empire of Japan'));const svg=mapSVG(d);assert.ok(svg.includes('#73dda2'));assert.ok(svg.includes('#ff6f78'));assert.ok(!mapSVG(d,{control:false}).includes('class="at-control"'));assert.ok(!mapSVG(maps.get(2026)).includes('class="at-feature at-selected'));assert.ok(!d.control.some(f=>f.name==='Union of Soviet Socialist Republics'));assert.ok(!mapSVG(d,{stateBorders:false}).includes('stroke="#73dda2"'));assert.ok(!mapSVG(d,{control:false,stateBorders:false}).includes('stroke="#ff6f78"'))});
+await test('Known anachronistic 1783 source labels are withheld and uncertainty remains explicit',()=>{const d=maps.get(1783);assert.ok(d.withheld.some(r=>r.sourceName==='New Netherland'));assert.ok(d.features.every(f=>f.uncertain));assert.ok(!eraRows(1783).some(r=>['New France','New Netherland','Kingdom of Naples (Napoleonic)'].includes(r.name)));assert.match(d.basis,/not an exhaustive/)});
+await test('Fictional nations do not acquire invented real-world polygons',()=>{const fictional=new Set(eraRows(2026,'Fictional').map(r=>r.id));for(const d of maps.values())assert.ok(d.features.every(f=>!fictional.has(f.countryId)))});
+await test('New-game dates and initial history use the chosen era without overwriting existing saves',()=>{for(const y of [2026,1942,1919,1783]){const c=COUNTRIES.find(c=>c.id===eraRows(y)[0].id),s=createState(c);initializeAtlasState(s);assert.equal(s.date.year,y);assert.equal(s.history[0].year,y);s.date.year++;initializeAtlasState(s);assert.equal(s.date.year,y+1);const clone=repairState(structuredClone(s));assert.equal(clone.atlas.era,y)}});
+await test('All expanded era templates survive actual engine advancement',()=>{for(const row of ATLAS_ROWS){const s=createState(COUNTRIES.find(c=>c.id===row.id));initializeAtlasState(s);step(s);for(const k of ['gdp','treasury','debt','inflation','unemployment'])assert.ok(Number.isFinite(s[k]),row.id+' '+k);assert.equal(s.atlas.era,row.era)}});
