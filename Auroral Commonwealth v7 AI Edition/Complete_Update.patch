+import {ledger,attach,detach} from '../worldline/core.js';
+const model=JSON.parse(fs.readFileSync(new URL('./model/policy-forest.json',import.meta.url))),report=JSON.parse(fs.readFileSync(new URL('./model/training-report.json',import.meta.url)));
+let count=0;const check=(name,fn)=>{fn();count++;console.log('  AI ✓ '+name)};
+const s=createState(COUNTRIES.find(c=>c.id==='ind'),'normal');initializeAtlasState(s);
+check('real model weights match engine and feature contract',()=>{validateModel(model);assert.equal(model.engineVersion,ENGINE_VERSION);assert.equal(model.trees.length,32);assert.equal(model.features.length,FEATURES.length);assert.equal(report.trainingExamples,report.trainingCountries.length*3*PROFILES.length);assert.ok(report.trainingHash.match(/^[a-f0-9]{64}$/))});
+check('evaluation partitions are disjoint by country and baseline is retained',()=>{const train=new Set(report.trainingCountries);assert.ok(report.testCountries.every(id=>!train.has(id)));assert.equal(report.testExamples,report.testCountries.length*3*PROFILES.length);assert.equal(report.metrics.length,7);for(const m of report.metrics){assert.ok(Number.isFinite(m.mae)&&m.mae>=0);assert.ok(Number.isFinite(m.baselineMAE))}assert.ok(report.balancedRanking.fixedProfileBaseline)});
+check('inference is deterministic, finite and never mutates the live nation',()=>{const original=structuredClone(s);for(const objective of ['balanced','growth','solvency']){const a=recommend(s,model,objective),b=recommend(s,model,objective);assert.deepEqual(a,b);assert.equal(a.length,7);for(const row of a){assert.equal(row.mean.length,7);assert.ok(row.mean.every(Number.isFinite));assert.ok(row.spread.every(n=>n>=0));assert.ok(Number.isFinite(row.score))}assert.deepEqual(a.find(r=>r.plan.id==='hold').mean,Array(7).fill(0))}assert.deepEqual(s,original)});
+check('historical and tiny states can be analysed without changing their era',()=>{for(const id of [COUNTRIES.find(c=>c.atlasEra===1783).id,'vat']){const nation=createState(COUNTRIES.find(c=>c.id===id));initializeAtlasState(nation);const original=fingerprint(nation);assert.equal(recommend(nation,model).length,7);assert.equal(fingerprint(nation),original)}});
+check('out-of-distribution state inputs are explicitly flagged',()=>{const changed=structuredClone(s);changed.debt=1e10;const result=predictVector(model,features(changed,planFor(changed,'hold')));assert.ok(result.outOfRange.includes('debt / GDP'))});
+check('corrupt models, NaNs and unsupported objectives are rejected',()=>{const corrupt=structuredClone(model);corrupt.trees[0]={f:900,t:0,l:{v:[]},r:{v:[]}};assert.throws(()=>validateModel(corrupt));const bad=structuredClone(s);bad.gdp=NaN;assert.throws(()=>features(bad,planFor(s,'hold')));assert.throws(()=>recommend(s,model,'constructor'))});
+check('policy commit uses the original setters, records a trace, and advances no months',()=>{const nation=structuredClone(s),plan=planFor(nation,'revenue'),before=structuredClone(nation),book=ledger('ai-test');attach(nation,book);try{assert.equal(commitPlan(nation,plan,fingerprint(nation)),true);assert.equal(nation.taxes.income,before.taxes.income+3);assert.equal(nation.taxes.sales,before.taxes.sales+1);assert.deepEqual(nation.date,before.date);assert.equal(nation.treasury,before.treasury);assert.deepEqual(nation.history,before.history);assert.ok(book.events.some(e=>e.source==='ai-policy'))}finally{detach(nation)}});
