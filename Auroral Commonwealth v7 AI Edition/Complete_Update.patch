+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import {createState} from '../game/state.js';
+import {COUNTRIES,initializeAtlasState} from '../atlas/registry.js';
+import {recommend,validateModel,predictVector} from './forest.js';
+import {PROFILES,FEATURES,TARGETS,features,planFor,fingerprint,gameContext} from './schema.js';
+import {commitPlan} from './actions.js';
+import {cleanRequest} from './server.mjs';
