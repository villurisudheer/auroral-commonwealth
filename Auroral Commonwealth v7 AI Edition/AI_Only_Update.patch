+const download=(name,object)=>{const a=document.createElement('a'),url=URL.createObjectURL(new Blob([JSON.stringify(object,null,2)],{type:'application/json'}));a.href=url;a.download=name;a.click();setTimeout(()=>URL.revokeObjectURL(url),1000)};
+let assetPromise;
+export async function loadAssets(){return assetPromise??=(async()=>{const paths=['./model/policy-forest.json','./model/training-report.json'];const data=await Promise.all(paths.map(async p=>{const r=await fetch(new URL(p,import.meta.url));if(!r.ok)throw Error('Bundled AI model could not be loaded');return r.json()}));if(data[0].engineVersion!==ENGINE_VERSION)throw Error('ML model engine version differs from this game. Retrain before using it.');validateModel(data[0]);return {model:data[0],report:data[1]}})().catch(e=>{assetPromise=null;throw e})}
+export function installIntelligence(api){
