+renderGame=function(){economyBaseRender();scenarioEconomyUI.sync()};
+
+// Apply the release label after the asynchronous bootstrap finishes.
+document.title='Auroral Commonwealth — v7.1 Chronicle Edition';
+
+// The starting briefing uses the same initialized currency, inflation and date as the actual campaign.
+const eraEconomyBaseBriefing=reviewStart;
+reviewStart=function(country,difficulty,custom){
+ eraEconomyBaseBriefing(country,difficulty,custom);
+ const preview=createState(country,difficulty,custom||{});initializeChronicleState(preview);initializeAtlasState(preview);attachChronicleCustom(preview);initializeEconomy(preview);
+ for(const card of app.querySelectorAll('.grid.four>.card')){const label=card.querySelector('.mini')?.textContent,value=card.querySelector('b');if(!value)continue;if(label==='GDP')value.textContent=fmt.money(preview.gdp,preview.currency);if(label==='Treasury')value.textContent=fmt.money(preview.treasury,preview.currency);if(label==='Debt')value.textContent=fmt.money(preview.debt,preview.currency);if(label==='Inflation')value.textContent=fmt.pct(preview.inflation)}
+ const note=document.createElement('p');note.className='notice';note.textContent=preview.economyScenario?preview.economyScenario.currency.name+' · '+preview.economyScenario.basis+'. Monetary amounts are scaled game accounting units.':'Original custom scenario accounting.';app.querySelector('.grid.four')?.after(note);
+ const start=app.querySelector('#start');if(start)start.onclick=()=>startGame(preview);
+};
