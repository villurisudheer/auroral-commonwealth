+ else if(type==='universities'){s=box(-24,2,23,35,28,color)+`<path d="M-26 -33l22-22 30 15-24 18Z" fill="#d7cef6"/><path d="M1 -50v-15l13 5-13 4" stroke="#a4f0e4" stroke-width="2" fill="#a4f0e4"/>`}
+ else{s=box(-24,5,24,type==='dataCenters'?38:52,30,color)+box(-8,-7,12,35,14,'#c7eaf3');s+=`<path d="M-14 -33l0 18m8-22v18m8-22v18m8-22v18" stroke="#e4fffc" opacity=".65" stroke-width="3"/>`;if(type==='researchCenters')s+='<circle cx="5" cy="-58" r="10" fill="none" stroke="#cfecff" stroke-width="3"/><path d="M-7-58h24M5-70v24" stroke="#cfecff" stroke-width="2"/>'}
