+import {BUILDINGS} from '../game/infrastructure.js';
+import {effectiveFactor,buildAllowed,resourceAvailable} from './economy.js';
+import {escapeText as esc} from '../atlas/map.js';
+export function installEconomyUI(api){
+ function sync(){const s=api.read(),e=s?.economyScenario;if(!e){document.documentElement.classList.remove('ch-pre-motor');return}document.documentElement.dataset.eraYear=String(e.year);document.documentElement.classList.toggle('ch-pre-motor',e.year<1900);const view=document.querySelector('#view');if(view&&!view.querySelector('[data-era-economy]')){const note=document.createElement('details');note.dataset.eraEconomy='';note.className='panel ch-economy-note';note.innerHTML='<summary>'+esc(e.currency.name)+' · '+s.inflation.toFixed(2)+'% inflation · price index '+(e.index*100).toFixed(1)+'</summary><p>'+esc(e.basis)+'. '+esc(e.currency.basis)+'. '+esc(e.monetaryScale)+'.</p><p>Past-era technology is locked where unsupported. Local accounting scales are calibrated game values; they are not historical price quotations or live exchange rates.</p>';view.prepend(note)}
+  for(const b of document.querySelectorAll('[data-build-tool]')){const key=b.dataset.buildTool,definition=BUILDINGS[key],small=b.querySelector('small');if(small){const label=s.currency+' '+(definition.cost*effectiveFactor(s)).toFixed(1)+'B';if(small.textContent!==label)small.textContent=label;}if(!buildAllowed(s,key)){b.disabled=true;b.title='Unavailable in this era'}}
+  for(const b of document.querySelectorAll('[data-action]')){const action=b.dataset.action,key=b.dataset.id;if(action==='build'){const allowed=buildAllowed(s,key);if(!allowed){b.disabled=true;if(b.textContent!=='Unavailable in this era')b.textContent='Unavailable in this era'}else{const label='Build · '+s.currency+' '+(BUILDINGS[key].cost*effectiveFactor(s)).toFixed(1)+'B';if(b.textContent!==label)b.textContent=label;b.disabled=s.treasury<BUILDINGS[key].cost*effectiveFactor(s)}}if(action==='research'&&e.year<1950){b.disabled=true;if(b.textContent!=='Future technology — unavailable')b.textContent='Future technology — unavailable'}if(['buyResource','exportResource'].includes(action)&&!resourceAvailable(s,key)){b.disabled=true;b.title='No supported industrial market for this resource in this era'}}
+  const tool=document.querySelector('[data-build-tool].selected')?.dataset.buildTool,place=document.querySelector('[data-place]');if(tool&&place){place.disabled=!buildAllowed(s,tool)||s.treasury<BUILDINGS[tool].cost*effectiveFactor(s);for(const line of document.querySelectorAll('.cd-inspector-line'))if(/Cost|Build another/.test(line.querySelector('span')?.textContent||'')){const b=line.querySelector('b'),label=s.currency+' '+(BUILDINGS[tool].cost*effectiveFactor(s)).toFixed(1)+'B';if(b&&b.textContent!==label)b.textContent=label}}
+  if(e.year<1750){for(const [selector,label] of [['[data-build-tool="schools"] b','School / academy'],['[data-build-tool="hospitals"] b','Healing district'],['[data-build-tool="universities"] b','Scholarly academy'],['[data-build-tool="roads"] b','Roads / caravan routes']]){const el=document.querySelector(selector);if(el&&el.textContent!==label)el.textContent=label}}
+ }
+ return {sync};
+}
