+export function installCommandDeck(api){
+ const style=document.createElement('link');style.rel='stylesheet';style.href=new URL('./style.css',import.meta.url);document.head.append(style);
+ const seen=new WeakSet();let current=null,root=null,placements=[],selected=null,tool=null,group='all',zoom=1,night=false,transaction=null,dialog=null,lastScene='',layoutKey='',toastTimer;
+ const groups={all:Object.keys(BUILDINGS),transport:['roads','railways','airports','ports'],energy:['powerPlants'],services:['hospitals','schools'],knowledge:['universities','dataCenters','researchCenters'],industry:['factories']};
+ const q=s=>root?.querySelector(s);
+ function storageGet(key){try{return localStorage.getItem(key)}catch{return null}}
+ function saveLayout(){try{localStorage.setItem(layoutKey,JSON.stringify({version:MAP_VERSION,placements}))}catch{notify('City layout could not be saved. Your game state is unaffected.')}}
+ function notify(text){const el=q('[data-cd-toast]');if(!el)return;el.textContent=text;el.hidden=false;clearTimeout(toastTimer);toastTimer=setTimeout(()=>{el.hidden=true},4000)}
+ function openAdmin(){if(dialog?.isConnected)return;dialog=document.createElement('dialog');dialog.className='cd-admin-modal';dialog.setAttribute('aria-label','Server administration');dialog.innerHTML='<header><div><span class="eyebrow">SERVER OPERATIONS</span><h2>Admin Console</h2></div><button class="btn" data-close>Close ×</button></header><iframe title="Authenticated server administration" src="command/admin.html"></iframe>';document.body.append(dialog);dialog.showModal();dialog.querySelector('[data-close]').onclick=()=>dialog.close();dialog.addEventListener('keydown',e=>e.stopPropagation());dialog.addEventListener('close',()=>{dialog.remove();dialog=null})}
+ function sync(){
+  const s=api.read();
+  if(!s){document.documentElement.classList.remove('cd-mode');root?.classList.remove('cd-expanded');root?.remove();const menu=document.querySelector('.hero .actions');if(menu&&!menu.querySelector('[data-admin-open]')){const button=document.createElement('button');button.className='btn';button.textContent='Admin Console';button.dataset.adminOpen='';button.onclick=openAdmin;menu.append(button)}return}
+  if(!seen.has(s)&&!api.isMultiplayer()){seen.add(s);api.initialView()}
+  current=s;const key='ac-command-city-v1:'+encodeURIComponent(s.countryId+'/'+s.name);
+  if(key!==layoutKey){layoutKey=key;placements=parseLayout(storageGet(key));selected=null;lastScene='';if(root)renderPalette()}
+  if(transaction&&(s.buildings[transaction.type]||0)===transaction.previous+1){placements=placePurchased(s,placements,transaction.tile,transaction.type,transaction.previous);transaction=null;saveLayout()}
+  placements=resolveCity(s,placements);
+  const sidebar=document.querySelector('.sidebar');if(sidebar&&!sidebar.querySelector('[data-command-view]')){
+   const button=document.createElement('button');button.className='navbtn';button.dataset.commandView='';button.textContent='◈ Command Deck';button.title='Interactive 2D Command Deck';button.onclick=()=>api.navigate('command2d');sidebar.prepend(button);
+   const admin=document.createElement('button');admin.className='navbtn';admin.textContent='⚙ Admin Console';admin.title='Server administration';admin.dataset.adminOpen='';admin.onclick=openAdmin;sidebar.append(admin);
+  }
+  const active=api.view()==='command2d';document.documentElement.classList.toggle('cd-mode',active);sidebar?.querySelector('[data-command-view]')?.classList.toggle('active',active);
+  if(!active)return;
