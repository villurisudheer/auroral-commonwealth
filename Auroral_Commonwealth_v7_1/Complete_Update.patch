+import {loadEpochMap,cameraFor} from '../chronicle/map.js';
+import {customFeatures} from '../chronicle/custom.js';
+import {stateEpoch,epochFor} from '../chronicle/registry.js';
+import {mapSVG,escapeText as esc} from '../atlas/map.js';
+import {countryISO,isDeep,bounds,gameplaySectors,enterDistrict} from './model.js';
+const cache=new Map();
+async function admin(iso,level){const key=iso+'/'+level;if(!cache.has(key))cache.set(key,fetch(new URL('./data/'+iso+'-adm'+level+'.geojson',import.meta.url)).then(async r=>{if(!r.ok)return null;return r.json()}).catch(()=>null));return cache.get(key)}
+export function installNationView(api){let root=null,current=null,token=0,camera=null,base=[],land=[],regions=[],districts=[],province=null,scope='country',identity='';
+ const q=s=>root?.querySelector(s);const motion=()=>api.read()?.settings.animations!==false&&!matchMedia('(prefers-reduced-motion: reduce)').matches;
+ function sync(){const s=api.read();if(!s){identity='';return}const nav=document.querySelector('[data-command-view]');if(nav){nav.textContent='◈ National 2D Map';nav.onclick=()=>api.navigate('nation2d');nav.classList.toggle('active',api.view()==='nation2d')}
+  if(api.view()==='command2d'&&s.activeDistrict){const heading=document.querySelector('.cd-heading');if(heading&&!heading.querySelector('[data-nation-breadcrumb]')){const line=document.createElement('p');line.dataset.nationBreadcrumb='';line.className='notice';line.textContent=s.name+' → '+[s.activeDistrict.parentName,s.activeDistrict.name].filter(Boolean).join(' → ')+'. This city contains only buildings assigned to this area; treasury and the economy are national.';heading.after(line)}}
+  if(api.view()!=='nation2d')return;
+  if(!root){root=document.createElement('section');root.className='nv-root';root.innerHTML='<header class="at-heading"><div><div class="eyebrow">NATIONAL COMMAND / GEOGRAPHIC VIEW</div><h1 data-nv-title></h1><p data-nv-subtitle></p></div><button class="btn" data-nv-atlas>World & continents</button></header><div class="nv-breadcrumb" data-nv-breadcrumb></div><div class="nv-grid"><div class="panel"><div class="actions"><button class="btn small" data-nv-plus aria-label="Zoom in">+</button><button class="btn small" data-nv-minus aria-label="Zoom out">−</button><button class="btn small" data-nv-fit>Fit selection</button><input data-nv-search placeholder="Find region or district…" aria-label="Search administrative units"></div><div class="ch-map-stage nv-map" data-nv-map></div><p class="mini" data-nv-source></p><p class="mini" data-nv-hover></p></div><aside class="panel"><h2 data-nv-list-title>Regions</h2><div class="nv-list" data-nv-list></div></aside></div><p class="notice" data-nv-note></p>';
+   q('[data-nv-atlas]').onclick=()=>api.navigate('chronicleAtlas');q('[data-nv-plus]').onclick=()=>camera?.zoom(1.4);q('[data-nv-minus]').onclick=()=>camera?.zoom(1/1.4);q('[data-nv-fit]').onclick=()=>camera?.frame(bounds(scope==='country'?base:[province]),true);q('[data-nv-search]').oninput=list;
+  }
+  document.querySelector('#view').replaceChildren(root);const id=s.countryId+'/'+stateEpoch(s);if(identity!==id){identity=id;load(s)}
+ }
+ async function load(s){current=s;province=null;scope='country';const request=++token;const era=epochFor(stateEpoch(s));q('[data-nv-title]').textContent=s.name;q('[data-nv-subtitle]').textContent=(era?.label||s.atlas?.era||'Scenario')+' · choose a region to govern locally';q('[data-nv-map]').textContent='Loading national outline and administrative regions…';
+  try{const data=await loadEpochMap(stateEpoch(s));if(token!==request)return;land=data.land||data.features;base=[...data.features,...data.control,...customFeatures(stateEpoch(s))].filter(f=>f.countryId===s.countryId);if(!base.length){q('[data-nv-map]').textContent='No real-world outline is assigned to this fictional or unmapped polity. Draw a custom territory in the Chronicle Atlas to create one.';q('[data-nv-list]').replaceChildren();return}
+   const modern=stateEpoch(s)==='modern',iso=countryISO(s),source=modern&&iso?await admin(iso,1):null;if(token!==request)return;regions=source?.features?.length?source.features:gameplaySectors(base,6,'game-'+s.countryId);districts=[];
+   if(modern&&isDeep(s)&&iso){const d=await admin(iso,2);if(token!==request)return;districts=d?.features||[];q('[data-nv-note]').textContent=(d?.basis||'District data unavailable; generated gameplay areas will be labelled.')+' First-level boundaries are Natural Earth reference cartography; disputed assignments and source dates are documented in nation/data/provenance.json.'}else q('[data-nv-note]').textContent=source?'Administrative source: Natural Earth maintained reference, not certified 2026 legal frontiers. Cities use a shared national economy; local building ownership is tracked separately.':'These are generated gameplay sectors clipped to the source outline. They are not historical provinces or surveyed borders. Cities use a national economy with local building ownership.';
+   render();
+  }catch(e){q('[data-nv-map]').textContent=e.message}
