+import {tiles,resolveCity,parseLayout,TITLES,COLORS,LAND} from '../command/model.js';
+import {escapeText as esc} from '../atlas/map.js';
+export function installCityTools(api){let signature='',root=null,index=0;
+ function sync(){const s=api.read(),deck=document.querySelector('.cd-deck');if(!s||!deck?.isConnected)return;const host=deck.querySelector('.cd-map-panel');if(!host)return;if(s.activeDistrict){const heading=deck.querySelector('.cd-heading h1'),label=s.activeDistrict.name+' · Local development';if(heading&&heading.textContent!==label)heading.textContent=label;deck.querySelectorAll('.cd-inspector-line>span').forEach(el=>{if(el.textContent==='Owned nationally')el.textContent='Owned in this area'});}
+  if(!root||!root.isConnected){root=document.createElement('section');root.className='ch-city-tools';root.setAttribute('aria-label','District navigation and minimap');root.innerHTML='<div class="ch-city-mini" data-city-mini></div><div><div class="eyebrow">DISTRICT EXPLORER</div><p data-city-status>Choose a plot on the minimap to inspect it in the city.</p><div class="actions"><button class="btn small" data-city-back>↑ Country map</button><button class="btn small" data-city-next>Next owned district</button><button class="btn small" data-city-empty>Find empty plot</button><button class="btn small" data-city-left aria-label="Pan left">←</button><button class="btn small" data-city-right aria-label="Pan right">→</button><button class="btn small" data-city-up aria-label="Pan up">↑</button><button class="btn small" data-city-down aria-label="Pan down">↓</button></div></div>';host.append(root);root.querySelector('[data-city-back]').onclick=()=>api.navigate('nation2d');for(const [name,dx,dy] of [['left',-180,0],['right',180,0],['up',0,-120],['down',0,120]])root.querySelector('[data-city-'+name+']').onclick=()=>deck.querySelector('.cd-viewport').scrollBy({left:dx,top:dy,behavior:motion()?'smooth':'instant'});root.querySelector('[data-city-next]').onclick=()=>{const ps=placements();if(ps.length)focus(ps[index++%ps.length].tile)};root.querySelector('[data-city-empty]').onclick=()=>{const used=new Set(placements().map(p=>p.tile)),tile=LAND.find(t=>!used.has(t.id));if(tile)focus(tile.id)};signature='';}
+  const ps=placements(),next=JSON.stringify(ps);if(signature===next)return;signature=next;const byTile=new Map(ps.map(p=>[p.tile,p]));root.querySelector('[data-city-mini]').innerHTML='<svg viewBox="90 10 1100 620" role="group" aria-label="Interactive district minimap">'+tiles().map(t=>{const p=byTile.get(t.id),fill=p?COLORS[p.type]:t.terrain==='water'?'#376580':t.terrain==='road'?'#7e8c94':'#355c4c';return `<path data-city-tile="${t.id}" tabindex="${t.terrain==='land'?0:-1}" role="button" aria-label="${esc((p?TITLES[p.type]:t.terrain)+' '+t.id)}" d="M${t.x} ${t.y}l44 23-44 23-44-23Z" fill="${fill}" stroke="#a3cdbb" stroke-width="1"/>`}).join('')+'</svg>';root.querySelectorAll('[data-city-tile]').forEach(b=>{const choose=()=>focus(b.dataset.cityTile);b.onclick=choose;b.onkeydown=e=>{if(['Enter',' '].includes(e.key)){e.preventDefault();e.stopPropagation();choose()}}});
+ }
+ function motion(){return api.read()?.settings.animations!==false&&!matchMedia('(prefers-reduced-motion: reduce)').matches}
+ function placements(){const s=api.read();let saved=[];try{saved=parseLayout(localStorage.getItem('ac-command-city-v1:'+encodeURIComponent(s.countryId+'/'+s.name)))}catch{}return resolveCity(s,saved)}
+ function focus(id){const tile=document.querySelector('.cd-viewport [data-tile="'+id+'"]');if(!tile||tile.getAttribute('aria-disabled')==='true')return;tile.dispatchEvent(new MouseEvent('click',{bubbles:true}));const target=document.querySelector('.cd-viewport [data-tile="'+id+'"]');target?.scrollIntoView({block:'center',inline:'center',behavior:motion()?'smooth':'instant'});target?.focus({preventScroll:true});const p=placements().find(p=>p.tile===id);root.querySelector('[data-city-status]').textContent=(p?TITLES[p.type]:'Available build plot')+' · local plot '+id+'. Districts show the national building pool; construction still spends the national treasury.'}
+ return {sync};
+}
