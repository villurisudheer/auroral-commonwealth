+export const EPOCHS=[{"key":"modern","year":2026,"label":"2026","title":"Modern world","start":[2026,1,1],"precision":"membership scenario","reason":"Modern UN membership, non-member, disputed and fictional categories."},{"key":"wwii","year":1942,"label":"WWII","title":"Axis expansion","start":[1942,11,1],"precision":"dated states + annual extent reconstructions","reason":"November 1942, near the height of German wartime expansion, before the major Axis reversals. Not a claim that every theatre peaked on the same day.","source":"https://encyclopedia.ushmm.org/content/en/article/german-wartime-expansion"},{"key":"wwi","year":1917,"label":"WWI","title":"Global escalation","start":[1917,7,1],"precision":"dated states + annual extent reconstructions","reason":"July 1917, after US entry and before Russia left the war; chosen as a broad-participation scenario, not a mathematically unique peak.","source":"https://www.army.mil/article/185229/world_war_i_building_the_american_military"},{"key":"unification","year":1871,"label":"1871","title":"New nation-states","start":[1871,1,1],"precision":"source-year reconstruction","reason":"German unification and the changing European balance after the Franco-Prussian War. The map is an annual reconstruction, not 1 January frontiers.","source":"https://www.bundestag.de/en/parliament/history/parliamentarism/empire"},{"key":"napoleonic","year":1812,"label":"1812","title":"Napoleonic Europe","start":[1812,1,1],"precision":"source-year reconstruction","reason":"Napoleonic dominance and the invasion of Russia; imperial dependencies and client states are separate source records.","source":"https://www.nam.ac.uk/explore/emperors-samovars"},{"key":"revolutions","year":1783,"label":"1783","title":"Age of revolutions","start":[1783,1,1],"precision":"source-year reconstruction","reason":"The existing revolutionary-era scenario is retained, with its documented source gaps."},{"key":"westphalia","year":1648,"label":"1648","title":"Westphalian transition","start":[1648,1,1],"precision":"source-year reconstruction","reason":"The end of the Thirty Years War and a major European territorial settlement; annual coverage cannot settle every treaty-day boundary."},{"key":"encounters","year":1492,"label":"1492","title":"Atlantic encounters","start":[1492,1,1],"precision":"source-year reconstruction","reason":"The fall of Granada and the opening of sustained transatlantic contact, alongside established societies in the Americas."},{"key":"constantinople","year":1453,"label":"1453","title":"Ottoman turning point","start":[1453,1,1],"precision":"source-year reconstruction","reason":"The Ottoman conquest of Constantinople and the end of the Byzantine imperial capital. Transition-year source records are not day-exact."},{"key":"mongol-expansion","year":1259,"label":"1259","title":"Mongol expansion","start":[1259,1,1],"precision":"source-year reconstruction","reason":"The last year of Mongke's rule, before the contested succession and increasing division among Mongol realms; not the maximum area ever ruled by all later khanates.","source":"https://faculty.washington.edu/dwaugh/hist225/225chron/mongchr.html"},{"key":"mongol-rise","year":1206,"label":"1206","title":"Mongols & Delhi","start":[1206,1,1],"precision":"source-year reconstruction","reason":"The proclamation of Genghis Khan and the emergence of the Delhi Sultanate mark a major Eurasian transition.","source":"https://www.metmuseum.org/toah/ht/07/nc"},{"key":"abbasid","year":750,"label":"AD 750","title":"Abbasids & Tang","start":[750,1,1],"precision":"source-year reconstruction","reason":"The Abbasid revolution reshaped the Islamic world during the Tang period in East Asia.","source":"https://www.metmuseum.org/toah/ht/06/wae"},{"key":"late-antiquity","year":476,"label":"AD 476","title":"Late antiquity","start":[476,1,1],"precision":"source-year reconstruction","reason":"The conventional end of the western Roman imperial office; Eastern Rome and successor kingdoms remain distinct."},{"key":"three-kingdoms","year":220,"label":"AD 220","title":"Han transition","start":[220,1,1],"precision":"source-year reconstruction","reason":"The end of the Han dynasty and transition into the Three Kingdoms period; yearly records may span regime changes.","source":"https://asia-archive.si.edu/learn/for-educators/teaching-china-with-the-smithsonian/explore-by-dynasty/han-dynasty/"},{"key":"trajan","year":117,"label":"AD 117","title":"Trajan's frontier","start":[117,1,1],"precision":"source-year reconstruction","reason":"Trajan's last year, associated with the Roman Empire's largest territorial reach; reconstructions do not resolve every short-lived occupation.","source":"https://www.iranicaonline.org/articles/trajan/"},{"key":"augustan","year":14,"label":"AD 14","title":"Augustan world","start":[14,1,1],"precision":"source-year reconstruction","reason":"The final year of Augustus; Rome, Parthia, Xin China and other source-mapped polities represent the 1st-century AD world.","source":"https://www.metmuseum.org/art/collection/search/247993"}];
