+import {ADMIN_COUNTRIES,ADMIN_ISO2} from './data/index.js';
+import {ATLAS_META,COUNTRIES,stateEpoch} from '../chronicle/registry.js';
+import {BUILDINGS} from '../game/infrastructure.js';
+export const DEEP_COUNTRIES=new Set(['IND','USA','RUS']);
+export function countryISO(s){const c=COUNTRIES.find(c=>c.id===s.countryId);return ADMIN_ISO2[c?.alpha2]||({'xkx':'KOS','cyn':'CYN','sml':'SOL'}[s.countryId])||(ADMIN_COUNTRIES[s.countryId?.toUpperCase()]?s.countryId.toUpperCase():null)}
+export function isDeep(s){const source=ATLAS_META.get(s.countryId)?.sourceName||s.name;return DEEP_COUNTRIES.has(countryISO(s))||/United States|Russia|Soviet|British India/.test(source)}
+export function bounds(features){const xs=[],ys=[];function visit(c){if(typeof c[0]==='number'){xs.push(c[0]);ys.push(c[1])}else c.forEach(visit)}features.forEach(f=>visit(f.geometry.coordinates));if(!xs.length)return [0,0,1200,600];if(xs.reduce((a,b)=>Math.max(a,b),-Infinity)-xs.reduce((a,b)=>Math.min(a,b),Infinity)>180)for(let i=0;i<xs.length;i++)if(xs[i]<0)xs[i]+=360;const x0=(xs.reduce((a,b)=>Math.min(a,b),Infinity)+180)/360*1200,x1=(xs.reduce((a,b)=>Math.max(a,b),-Infinity)+180)/360*1200,y0=(90-ys.reduce((a,b)=>Math.max(a,b),-Infinity))/180*600,y1=(90-ys.reduce((a,b)=>Math.min(a,b),Infinity))/180*600;const w=Math.max(8,x1-x0),h=Math.max(5,y1-y0),pad=Math.max(w,h)*.07;return [x0-pad,y0-pad,w+2*pad,h+2*pad]}
+export function gameplaySectors(features,count=6,prefix='sector'){
+ const b=bounds(features),left=b[0]/1200*360-180,right=(b[0]+b[2])/1200*360-180;
+ function clip(ring,min,max){let points=ring.slice(0,-1).map(p=>[...p]);if(right>180)points=points.map(([x,y])=>[x<0?x+360:x,y]);for(const [edge,inside] of [[min,p=>p[0]>=min],[max,p=>p[0]<=max]]){const result=[];for(let i=0;i<points.length;i++){const a=points[i],c=points[(i+1)%points.length],ai=inside(a),ci=inside(c);if(ai)result.push(a);if(ai!==ci){const t=(edge-a[0])/(c[0]-a[0]);result.push([edge,a[1]+t*(c[1]-a[1])])}}points=result;if(!points.length)break}if(points.length<3)return null;const normal=points.map(([x,y])=>[x>180?x-360:x,y]);return [...normal,[...normal[0]]]}
+ const out=[];for(let i=0;i<count;i++){const polygons=[];for(const f of features)for(const poly of f.geometry.type==='Polygon'?[f.geometry.coordinates]:f.geometry.coordinates){const ring=clip(poly[0],left+(right-left)*i/count,left+(right-left)*(i+1)/count);if(ring)polygons.push([ring])}if(polygons.length)out.push({type:'Feature',id:prefix+'-'+(i+1),name:'Gameplay region '+(i+1),unit:'Fictional gameplay sector',geometry:{type:'MultiPolygon',coordinates:polygons},source:'Generated longitude bands clipped to the selected source outline; not historical administrative geography.',properties:{name:'Gameplay region '+(i+1)},fictional:true})}return out;
+}
+export function enterDistrict(s,{id,name,parentName='',source=''}){
+ if(!s||typeof id!=='string'||id.length>160)throw Error('Invalid district');s.districtCities??={};const key=id;if(!s.districtCities[key]){const first=Object.keys(s.districtCities).length===0;s.districtCities[key]={name,parentName,source,buildings:Object.fromEntries(Object.keys(BUILDINGS).map(k=>[k,first?(s.buildings[k]||0):0]))};if(first)s.capitalDistrict=key}s.activeDistrict={id:key,name,parentName};return s.activeDistrict;
+}
+const proxies=new WeakMap();
+export function districtViewState(s){if(!s?.activeDistrict||!s.districtCities?.[s.activeDistrict.id])return s;let map=proxies.get(s);if(!map){map=new Map();proxies.set(s,map)}const id=s.activeDistrict.id;if(!map.has(id))map.set(id,new Proxy(s,{get(target,key){if(key==='buildings')return target.districtCities[id].buildings;if(key==='name'){const d=target.districtCities[id];return target.name+' — '+[d.parentName,d.name].filter(Boolean).join(' / ')}return Reflect.get(target,key)}}));return map.get(id)}
+export function recordDistrictBuild(s,previous){const key=s?.activeDistrict?.id,city=s?.districtCities?.[key];if(!city)return false;let changed=false;for(const type of Object.keys(BUILDINGS)){const delta=(s.buildings[type]||0)-(previous[type]||0);if(delta>0){city.buildings[type]=(city.buildings[type]||0)+delta;changed=true}}return changed}
