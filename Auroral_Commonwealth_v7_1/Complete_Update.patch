+ return `<svg class="cd-map" viewBox="0 0 1280 760" role="group" aria-label="Interactive isometric national development map"><defs><linearGradient id="cd-sea" x2="0" y2="1"><stop stop-color="#123a55"/><stop offset="1" stop-color="#0c223b"/></linearGradient><linearGradient id="cd-land"><stop stop-color="#326768"/><stop offset="1" stop-color="#234b56"/></linearGradient><pattern id="cd-grid" width="92" height="48" patternUnits="userSpaceOnUse"><path d="M46 0L92 24 46 48 0 24Z" fill="none" stroke="#80d8dd" stroke-opacity=".025"/></pattern><filter id="cd-shadow"><feDropShadow dx="0" dy="6" stdDeviation="4" flood-opacity=".25"/></filter>${Object.keys(TITLES).map(k=>`<symbol id="cd-building-${k}" viewBox="-50 -90 100 125">${building(k)}</symbol>`).join('')}</defs><rect width="1280" height="760" rx="24" fill="url(#cd-sea)"/><rect width="1280" height="760" fill="url(#cd-grid)"/><g class="cd-tide" fill="none" stroke="#77cee0" stroke-opacity=".12"><path d="M890 145l130 65m-150-35 175 88M980 320l140 70m-120-25 115 58"/></g><text x="1120" y="210" fill="#82b3c7" font-size="12" letter-spacing="4" transform="rotate(27 1120 210)">AURORAL SEA</text>
